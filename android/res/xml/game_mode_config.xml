<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ Game Mode: the game answers to the system's Performance and
     Battery modes (Game Dashboard, the makers' game launchers). It sets its
     own resolution and frame rate, so the system does not change them. -->
<game-mode-config xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsBatteryGameMode="true"
    android:supportsPerformanceGameMode="true"
    android:allowGameDownscaling="false"
    android:allowGameFpsOverride="false" />
